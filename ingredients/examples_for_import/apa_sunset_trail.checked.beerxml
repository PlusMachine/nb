<?xml version="1.0" encoding="UTF-8"?>
<RECIPES>
  <RECIPE>
    <NAME>Sunset Trail APA</NAME>
    <VERSION>1</VERSION>
    <TYPE>All Grain</TYPE>
    <BREWER>OpenAI example</BREWER>
    <BATCH_SIZE>20.0</BATCH_SIZE>
    <BOIL_SIZE>27.0</BOIL_SIZE>
    <BOIL_TIME>60</BOIL_TIME>
    <EFFICIENCY>74.0</EFFICIENCY>
    <NOTES>Example APA with clean fermentation, citrus-forward hops, and a small caramel backbone.</NOTES>
    <OG>1.054</OG>
    <FG>1.011</FG>
    <IBU>36.0</IBU>
    <COLOR>8.0</COLOR>
    <ABV>5.6</ABV>
    <CARBONATION>2.4</CARBONATION>
    <FERMENTABLES>
      <FERMENTABLE>
        <NAME>Pale Ale Malt</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>4.4000</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>3.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Munich Malt</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>0.3500</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>8.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Crystal 40L</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>0.2500</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>40.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Carapils</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>0.1500</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>1.5</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
    </FERMENTABLES>
    <HOPS>
      <HOP>
        <NAME>Cascade</NAME>
        <VERSION>1</VERSION>
        <ALPHA>6.5</ALPHA>
        <AMOUNT>0.02000</AMOUNT>
        <USE>Boil</USE>
        <TIME>60</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Centennial</NAME>
        <VERSION>1</VERSION>
        <ALPHA>10.0</ALPHA>
        <AMOUNT>0.02000</AMOUNT>
        <USE>Boil</USE>
        <TIME>15</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Cascade</NAME>
        <VERSION>1</VERSION>
        <ALPHA>6.5</ALPHA>
        <AMOUNT>0.03000</AMOUNT>
        <USE>Aroma</USE>
        <TIME>20</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Centennial</NAME>
        <VERSION>1</VERSION>
        <ALPHA>10.0</ALPHA>
        <AMOUNT>0.03000</AMOUNT>
        <USE>Aroma</USE>
        <TIME>20</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Cascade</NAME>
        <VERSION>1</VERSION>
        <ALPHA>6.5</ALPHA>
        <AMOUNT>0.03500</AMOUNT>
        <USE>Dry Hop</USE>
        <TIME>4320</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Centennial</NAME>
        <VERSION>1</VERSION>
        <ALPHA>10.0</ALPHA>
        <AMOUNT>0.02500</AMOUNT>
        <USE>Dry Hop</USE>
        <TIME>4320</TIME>
        <FORM>Pellet</FORM>
      </HOP>
    </HOPS>
    <MISCS>
      <MISC>
        <NAME>Whirlfloc Tablet</NAME>
        <VERSION>1</VERSION>
        <TYPE>Fining</TYPE>
        <USE>Boil</USE>
        <TIME>10</TIME>
        <AMOUNT>1.00000</AMOUNT>
        <AMOUNT_IS_WEIGHT>FALSE</AMOUNT_IS_WEIGHT>
      </MISC>
    </MISCS>
    <YEASTS>
      <YEAST>
        <NAME>SafAle US-05</NAME>
        <VERSION>1</VERSION>
        <TYPE>Ale</TYPE>
        <FORM>Dry</FORM>
        <AMOUNT>0.01150</AMOUNT>
        <AMOUNT_IS_WEIGHT>TRUE</AMOUNT_IS_WEIGHT>
        <LABORATORY>Fermentis</LABORATORY>
        <PRODUCT_ID>US-05</PRODUCT_ID>
        <ATTENUATION>78.0</ATTENUATION>
      </YEAST>
    </YEASTS>
    <STYLE>
      <NAME>American Pale Ale</NAME>
      <CATEGORY>Pale Ale</CATEGORY>
      <VERSION>1</VERSION>
      <TYPE>Ale</TYPE>
      <OG_MIN>1.046</OG_MIN>
      <OG_MAX>1.062</OG_MAX>
      <FG_MIN>1.007</FG_MIN>
      <FG_MAX>1.015</FG_MAX>
      <IBU_MIN>28.0</IBU_MIN>
      <IBU_MAX>44.0</IBU_MAX>
      <COLOR_MIN>5.0</COLOR_MIN>
      <COLOR_MAX>11.0</COLOR_MAX>
      <ABV_MIN>4.6</ABV_MIN>
      <ABV_MAX>6.6</ABV_MAX>
    </STYLE>
    <MASH>
      <NAME>Sunset Trail APA Mash</NAME>
      <VERSION>1</VERSION>
      <GRAIN_TEMP>22.0</GRAIN_TEMP>
      <TUN_TEMP>22.0</TUN_TEMP>
      <SPARGE_TEMP>76.0</SPARGE_TEMP>
      <PH>5.4</PH>
      <MASH_STEPS>
        <MASH_STEP>
          <NAME>Saccharification</NAME>
          <VERSION>1</VERSION>
          <TYPE>Infusion</TYPE>
          <STEP_TEMP>66.0</STEP_TEMP>
          <STEP_TIME>60</STEP_TIME>
        </MASH_STEP>
        <MASH_STEP>
          <NAME>Mash Out</NAME>
          <VERSION>1</VERSION>
          <TYPE>Infusion</TYPE>
          <STEP_TEMP>76.0</STEP_TEMP>
          <STEP_TIME>10</STEP_TIME>
        </MASH_STEP>
      </MASH_STEPS>
    </MASH>
    <PRIMARY_AGE>7</PRIMARY_AGE>
    <PRIMARY_TEMP>18.0</PRIMARY_TEMP>
    <SECONDARY_AGE>5</SECONDARY_AGE>
    <SECONDARY_TEMP>20.0</SECONDARY_TEMP>
    <TERTIARY_AGE>3</TERTIARY_AGE>
    <TERTIARY_TEMP>18.0</TERTIARY_TEMP>
    <AGE>2</AGE>
    <AGE_TEMP>3.0</AGE_TEMP>
  </RECIPE>
