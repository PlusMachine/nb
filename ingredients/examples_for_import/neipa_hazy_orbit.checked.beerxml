<?xml version="1.0" encoding="UTF-8"?>
<RECIPES>
  <RECIPE>
    <NAME>Hazy Orbit NEIPA</NAME>
    <VERSION>1</VERSION>
    <TYPE>All Grain</TYPE>
    <BREWER>OpenAI example</BREWER>
    <BATCH_SIZE>20.0</BATCH_SIZE>
    <BOIL_SIZE>27.0</BOIL_SIZE>
    <BOIL_TIME>30</BOIL_TIME>
    <EFFICIENCY>72.0</EFFICIENCY>
    <NOTES>Example NEIPA focused on soft bitterness, heavy whirlpool, and expressive dry hop.</NOTES>
    <OG>1.068</OG>
    <FG>1.014</FG>
    <IBU>37.0</IBU>
    <COLOR>6.0</COLOR>
    <ABV>7.1</ABV>
    <CARBONATION>2.4</CARBONATION>
    <FERMENTABLES>
      <FERMENTABLE>
        <NAME>Pale Ale Malt</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>4.6000</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>3.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Flaked Oats</NAME>
        <VERSION>1</VERSION>
        <TYPE>Adjunct</TYPE>
        <AMOUNT>0.8000</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>1.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Wheat Malt</NAME>
        <VERSION>1</VERSION>
        <TYPE>Grain</TYPE>
        <AMOUNT>0.7000</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>2.0</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Flaked Wheat</NAME>
        <VERSION>1</VERSION>
        <TYPE>Adjunct</TYPE>
        <AMOUNT>0.3500</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>1.6</COLOR>
        <ADD_AFTER_BOIL>FALSE</ADD_AFTER_BOIL>
      </FERMENTABLE>
      <FERMENTABLE>
        <NAME>Dextrose</NAME>
        <VERSION>1</VERSION>
        <TYPE>Sugar</TYPE>
        <AMOUNT>0.3000</AMOUNT>
        <YIELD>80.0</YIELD>
        <COLOR>0.0</COLOR>
        <ADD_AFTER_BOIL>TRUE</ADD_AFTER_BOIL>
      </FERMENTABLE>
    </FERMENTABLES>
    <HOPS>
      <HOP>
        <NAME>Magnum</NAME>
        <VERSION>1</VERSION>
        <ALPHA>12.0</ALPHA>
        <AMOUNT>0.01000</AMOUNT>
        <USE>Boil</USE>
        <TIME>30</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Citra</NAME>
        <VERSION>1</VERSION>
        <ALPHA>12.0</ALPHA>
        <AMOUNT>0.04000</AMOUNT>
        <USE>Aroma</USE>
        <TIME>20</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Mosaic</NAME>
        <VERSION>1</VERSION>
        <ALPHA>11.5</ALPHA>
        <AMOUNT>0.04000</AMOUNT>
        <USE>Aroma</USE>
        <TIME>20</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Galaxy</NAME>
        <VERSION>1</VERSION>
        <ALPHA>14.0</ALPHA>
        <AMOUNT>0.03000</AMOUNT>
        <USE>Aroma</USE>
        <TIME>20</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Citra</NAME>
        <VERSION>1</VERSION>
        <ALPHA>12.0</ALPHA>
        <AMOUNT>0.06000</AMOUNT>
        <USE>Dry Hop</USE>
        <TIME>4320</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Mosaic</NAME>
        <VERSION>1</VERSION>
        <ALPHA>11.5</ALPHA>
        <AMOUNT>0.06000</AMOUNT>
        <USE>Dry Hop</USE>
        <TIME>4320</TIME>
        <FORM>Pellet</FORM>
      </HOP>
      <HOP>
        <NAME>Galaxy</NAME>
        <VERSION>1</VERSION>
        <ALPHA>14.0</ALPHA>
        <AMOUNT>0.04000</AMOUNT>
        <USE>Dry Hop</USE>
        <TIME>4320</TIME>
        <FORM>Pellet</FORM>
      </HOP>
    </HOPS>
    <MISCS>
      <MISC>
        <NAME>Whirlfloc Tablet</NAME>
        <VERSION>1</VERSION>
        <TYPE>Fining</TYPE>
        <USE>Boil</USE>
        <TIME>10</TIME>
        <AMOUNT>1.00000</AMOUNT>
        <AMOUNT_IS_WEIGHT>FALSE</AMOUNT_IS_WEIGHT>
      </MISC>
      <MISC>
        <NAME>Yeast Nutrient</NAME>
        <VERSION>1</VERSION>
        <TYPE>Other</TYPE>
        <USE>Boil</USE>
        <TIME>10</TIME>
        <AMOUNT>0.00500</AMOUNT>
        <AMOUNT_IS_WEIGHT>TRUE</AMOUNT_IS_WEIGHT>
      </MISC>
    </MISCS>
    <YEASTS>
      <YEAST>
        <NAME>Wyeast 1318 London Ale III</NAME>
        <VERSION>1</VERSION>
        <TYPE>Ale</TYPE>
        <FORM>Liquid</FORM>
        <AMOUNT>1.00000</AMOUNT>
        <AMOUNT_IS_WEIGHT>FALSE</AMOUNT_IS_WEIGHT>
        <LABORATORY>Wyeast</LABORATORY>
        <PRODUCT_ID>1318</PRODUCT_ID>
        <ATTENUATION>75.0</ATTENUATION>
      </YEAST>
    </YEASTS>
    <STYLE>
      <NAME>New England IPA</NAME>
      <CATEGORY>IPA</CATEGORY>
      <VERSION>1</VERSION>
      <TYPE>Ale</TYPE>
      <OG_MIN>1.060</OG_MIN>
      <OG_MAX>1.076</OG_MAX>
      <FG_MIN>1.010</FG_MIN>
      <FG_MAX>1.018</FG_MAX>
      <IBU_MIN>29.0</IBU_MIN>
      <IBU_MAX>45.0</IBU_MAX>
      <COLOR_MIN>3.0</COLOR_MIN>
      <COLOR_MAX>9.0</COLOR_MAX>
      <ABV_MIN>6.1</ABV_MIN>
      <ABV_MAX>8.1</ABV_MAX>
    </STYLE>
    <MASH>
      <NAME>Hazy Orbit NEIPA Mash</NAME>
      <VERSION>1</VERSION>
      <GRAIN_TEMP>22.0</GRAIN_TEMP>
      <TUN_TEMP>22.0</TUN_TEMP>
      <SPARGE_TEMP>76.0</SPARGE_TEMP>
      <PH>5.4</PH>
      <MASH_STEPS>
        <MASH_STEP>
          <NAME>Saccharification</NAME>
          <VERSION>1</VERSION>
          <TYPE>Infusion</TYPE>
          <STEP_TEMP>67.0</STEP_TEMP>
          <STEP_TIME>60</STEP_TIME>
        </MASH_STEP>
        <MASH_STEP>
          <NAME>Mash Out</NAME>
          <VERSION>1</VERSION>
          <TYPE>Infusion</TYPE>
          <STEP_TEMP>76.0</STEP_TEMP>
          <STEP_TIME>10</STEP_TIME>
        </MASH_STEP>
      </MASH_STEPS>
    </MASH>
    <PRIMARY_AGE>4</PRIMARY_AGE>
    <PRIMARY_TEMP>19.0</PRIMARY_TEMP>
    <SECONDARY_AGE>5</SECONDARY_AGE>
    <SECONDARY_TEMP>21.0</SECONDARY_TEMP>
    <TERTIARY_AGE>3</TERTIARY_AGE>
    <TERTIARY_TEMP>20.0</TERTIARY_TEMP>
    <AGE>2</AGE>
    <AGE_TEMP>3.0</AGE_TEMP>
  </RECIPE>
</RECIPES>
