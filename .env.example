NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nb
APP_URL=http://localhost:3000
AUTH_SECRET=replace_with_32_plus_chars_secret
AUTH_FROM_EMAIL=no-reply@localhost.dev
# Только для разработки: автологин под этим email без формы входа.
# Игнорируется при NODE_ENV=production. Оставьте пустым, чтобы отключить.
DEV_AUTH_EMAIL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
STORAGE_PROVIDER=mock
STORAGE_BUCKET=nb-local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# SMS-авторизация. dev: оставьте "log" — код входа печатается в логи сервера.
# prod: "smsc" (SMSC.ru) или "smsru" (SMS.ru) + реквизиты ниже.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_LOGIN=
SMS_SENDER=
AUTH_VK_CLIENT_ID=
AUTH_VK_CLIENT_SECRET=
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
AUTH_CAPTCHA_SECRET=
NEXT_PUBLIC_AUTH_CAPTCHA_SITE_KEY=

# --- BrewForge: облачный путь варки («варка откуда угодно») -------------------
# Брокер MQTT портала. Задан → портал ведёт устройства БЕЗ localUrl через облако:
# телеметрию читает из brew_telemetry (её пишет apps/bridge), команды публикует в
# брокер (features/brew-controller/cloud-transport.ts + mqtt-client.ts). Пусто →
# только LAN-REST (устройство достижимо по device.localUrl из той же сети).
# Для облака нужны: docker compose up -d mosquitto  +  npm run dev -w @nb/bridge.
BREWFORGE_MQTT_URL=mqtt://localhost:1883
# Логин/пароль брокера (если включена аутентификация; dev-mosquitto анонимный).
BREWFORGE_MQTT_USERNAME=
BREWFORGE_MQTT_PASSWORD=
# Принудительно гнать ВСЕ устройства через облако (даже с заданным localUrl) —
# напр. на cloud-деплое nb, где LAN-адрес из домашней сети сервером недостижим.
BREWFORGE_PREFER_CLOUD=
# Per-device bearer-токен для LAN-REST (Authorization: Bearer). dev-фолбэк:
# BREWFORGE_DEVICE_TOKEN; на устройство — BREWFORGE_DEVICE_TOKEN_<deviceId>.
BREWFORGE_DEVICE_TOKEN=
# Разрешить LAN-транспорту ходить на loopback (127.0.0.1/::1/localhost) в production.
# Вне production loopback разрешён всегда (нужен для локального device-sim). Не включать
# на реальном проде — это дверь для localhost-SSRF.
BREWFORGE_ALLOW_LOOPBACK_DEVICE=
# Kill-switch: полностью запретить LAN-транспорт (напр. на деплоях без прямого доступа
# к устройствам пользователя).
BREWFORGE_LAN_TRANSPORT_DISABLED=

# --- BrewForge: демо без железа (Phase 0) --------------------------------------
# Локальный device-sim (виртуальный контроллер): npm run dev:sim (порт 8090 по умолчанию).
# Кнопка «Демо-пивоварня» на /app/devices создаёт устройство с localUrl на этот адрес.
# Доступно вне production (или под явным BREWFORGE_ALLOW_LOOPBACK_DEVICE выше).
BREWFORGE_DEMO_SIM_URL=http://127.0.0.1:8090

# --- Web-push уведомления (Phase 6) -------------------------------------------
# Пуши о промптах (засыпь/промывка) и авариях. Отправляет always-on мост (@nb/bridge)
# через @nb/push; портал управляет подписками. Сгенерировать пару ключей один раз:
#   npx web-push generate-vapid-keys
# Публичный ключ отдаётся клиенту (/api/notifications/public-key), приватный — секрет.
# Пусто = пуши выключены (opt-in в UI скрыт). В production web-push требует HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Cloud-плечо dead-man (Phase 6b, читает мост @nb/bridge). При «ручной нагрев включён,
# а управляющий сеанс потерян» мост ВСЕГДА шлёт пуш «проверьте пивоварню». Этот флаг
# доп. включает АВТОНОМНЫЙ EXIT_MANUAL из облака — рискованно (ложное срабатывание при
# обрыве связи), первичная защита — firmware dead-man на плате. Пусто/0 = только пуш.
BREWFORGE_CLOUD_DEADMAN_STOP=
