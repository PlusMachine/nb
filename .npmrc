# pnpm: плоский node_modules (как у npm), чтобы не ломать пакеты, рассчитанные
# на hoisting (например, @types/react, видимый из @nb/ui без явного объявления).
# Дедупликация через общий content-addressable store при этом сохраняется —
# файлы всё равно хардлинки в ~/.local/share/pnpm/store.
node-linker=hoisted
