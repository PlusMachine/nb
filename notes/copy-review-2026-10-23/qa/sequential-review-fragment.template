<style>
#nb-copy-review { color:var(--foreground); }
#nb-copy-review .review-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin:14px 0; }
#nb-copy-review .wording { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:20px; margin:20px 0; }
#nb-copy-review .wording p { margin:6px 0 0; white-space:pre-wrap; overflow-wrap:anywhere; }
#nb-copy-review .context { margin:16px 0 6px; font-weight:500; }
#nb-copy-review .section, #nb-copy-review .wording-label { color:var(--muted-foreground); }
#nb-copy-review .choices { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
#nb-copy-review .reason { margin:16px 0; }
#nb-copy-review .source { margin:16px 0; }
#nb-copy-review .source code { overflow-wrap:anywhere; white-space:normal; }
#nb-copy-review textarea { width:100%; box-sizing:border-box; }
#nb-copy-review .jump { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
#nb-copy-review .jump input { max-width:88px; }
#nb-copy-review [hidden] { display:none !important; }
@media(max-width:580px) { #nb-copy-review .wording { grid-template-columns:1fr; gap:16px; } }
</style>
<div id="nb-copy-review">
  <div class="review-row">
    <span id="nb-position" class="tabular-nums" aria-live="polite">Пункт 1 из 320</span>
    <span id="nb-progress" class="text-small tabular-nums">Решено 0 из 320</span>
  </div>
  <div id="nb-section" class="section text-small"></div>
  <p id="nb-context" class="context"></p>
  <div class="wording">
    <div><span class="wording-label text-small">Сейчас</span><p id="nb-before"></p></div>
    <div><span class="wording-label text-small">Предлагаю</span><p id="nb-after"></p></div>
  </div>
  <p id="nb-reason" class="reason text-small"></p>
  <div class="choices" role="group" aria-label="Ваше решение">
    <button class="btn" type="button" id="nb-approve" aria-pressed="false">Одобрить</button>
    <button class="btn" type="button" id="nb-reject" aria-pressed="false">Отклонить</button>
    <button class="btn" type="button" id="nb-custom" aria-pressed="false">Свой вариант</button>
  </div>
  <div id="nb-custom-box" hidden>
    <label class="form-label" id="nb-custom-label" for="nb-custom-text">Ваш вариант</label>
    <textarea class="form-control" id="nb-custom-text" rows="3" placeholder="Напишите свою формулировку"></textarea>
    <div class="review-row"><button class="btn" id="nb-save-custom" type="button">Сохранить и дальше</button></div>
  </div>
  <details class="source text-small"><summary class="cursor-interaction">Где находится текст</summary><div id="nb-sources"></div></details>
  <div class="review-row">
    <button class="btn" type="button" id="nb-prev">Назад</button>
    <span id="nb-decision" class="text-small" aria-live="polite"></span>
    <button class="btn" type="button" id="nb-next">Дальше</button>
  </div>
  <hr>
  <div class="review-row">
    <label class="jump" for="nb-jump"><span class="text-small">К пункту</span><input class="form-control" type="number" min="1" max="320" id="nb-jump" value="1"></label>
    <button class="btn btn-primary" type="button" id="nb-send" disabled>Передать решения</button>
  </div>
  <p class="text-small" id="nb-status" role="status"></p>
  <div id="nb-transfer-box" hidden>
    <label class="form-label" for="nb-transfer">Скопируйте решения и отправьте их в этот чат</label>
    <textarea class="form-control" readonly id="nb-transfer" rows="5"></textarea>
    <div class="review-row"><button class="btn" id="nb-copy" type="button">Скопировать решения</button></div>
  </div>
</div>
<script type="application/json" id="nb-copy-review-data">__REVIEW_DATA__</script>
<script>
(() => {
  const root=document.getElementById('nb-copy-review');
  const proposals=JSON.parse(document.getElementById('nb-copy-review-data').textContent).proposals;
  const $=id=>root.querySelector('#'+id);
  const known=new Set(proposals.map(p=>p.id));
  const decisions=new Map();
  const audit='nb-copy-2026-10-23-v1';
  let position=0, timer, sending=false;
  const current=id=>decisions.get(id)||{choice:'pending',text:''};
  function restore(state) {
    if(state?.modelContent?.audit!==audit)return false;
    decisions.clear();
    for(const row of state.modelContent.decisions||[]) {
      if(Array.isArray(row)&&known.has(row[0])&&['approve','reject','custom'].includes(row[1]))decisions.set(row[0],{choice:row[1],text:typeof row[2]==='string'?row[2]:''});
    }
    for(const [id,text] of Object.entries(state.privateContent?.drafts||{})) {
      if(known.has(id)&&typeof text==='string'&&current(id).choice!=='custom')decisions.set(id,{...current(id),text});
    }
    const saved=state.privateContent?.position;
    if(Number.isInteger(saved))position=Math.min(proposals.length-1,Math.max(0,saved));
    return true;
  }
  function snapshot() {
    return {modelContent:{audit,decisions:[...decisions].filter(([,d])=>d.choice!=='pending').map(([id,d])=>d.choice==='custom'?[id,d.choice,d.text]:[id,d.choice])},privateContent:{position,drafts:Object.fromEntries([...decisions].filter(([,d])=>d.text&&d.choice!=='custom').map(([id,d])=>[id,d.text]))}};
  }
  async function persist() {
    if(!window.openai?.setWidgetState)return;
    const state=snapshot();
    if(new TextEncoder().encode(JSON.stringify(state)).length>15500){$('nb-status').textContent='Слишком много текста для автосохранения. Передайте решения в чат перед закрытием.';return;}
    try{await window.openai.setWidgetState(state);}catch{$('nb-status').textContent='Не удалось сохранить выбор. Передайте решения в чат перед закрытием.';}
  }
  function scheduleSave(){clearTimeout(timer);timer=setTimeout(persist,250);}
  function render() {
    const p=proposals[position],d=current(p.id);
    $('nb-position').textContent=`Пункт ${position+1} из ${proposals.length} · ${p.id}`;
    const selected=[...decisions.values()].filter(x=>x.choice!=='pending');
    $('nb-progress').textContent=`Решено ${selected.length} из ${proposals.length}`;
    $('nb-section').textContent=p.section;
    $('nb-context').textContent=p.where;
    $('nb-before').textContent=p.before;
    $('nb-after').textContent=p.after;
    $('nb-reason').textContent=p.reason;
    for(const choice of ['approve','reject','custom'])$('nb-'+choice).setAttribute('aria-pressed',String(d.choice===choice));
    $('nb-custom-box').hidden=d.choice!=='custom';
    const input=$('nb-custom-text');
    if(input.value!==d.text)input.value=d.text;
    input.maxLength=p.kind==='Описание пива'?220:1800;
    $('nb-custom-label').textContent=p.kind==='Описание пива'?'Ваш вариант · до 220 символов':'Ваш вариант';
    $('nb-decision').textContent=({approve:'Одобрено',reject:'Отклонено',custom:d.text.trim()?'Свой вариант':'Впишите свой вариант',pending:'Не решено'})[d.choice];
    $('nb-prev').disabled=position===0;
    $('nb-next').disabled=position===proposals.length-1;
    $('nb-jump').max=String(proposals.length);$('nb-jump').value=String(position+1);
    $('nb-send').disabled=!selected.length||sending;
    $('nb-transfer-box').hidden=true;
    $('nb-sources').replaceChildren(...p.sources.map(ref=>{const line=document.createElement('p'),code=document.createElement('code');code.textContent=`${ref.file}:${ref.line}`;line.append(code);return line;}));
  }
  function advance(){if(position<proposals.length-1)position++;else $('nb-status').textContent='Вы дошли до последнего пункта. Можно передать выбранные решения.';}
  function choose(choice) {
    const p=proposals[position],d=current(p.id);
    decisions.set(p.id,{choice,text:d.text});
    if(choice!=='custom')advance();
    render();scheduleSave();
    if(choice==='custom')$('nb-custom-text').focus();
  }
  restore(window.openai?.widgetState);
  render();
  $('nb-approve').addEventListener('click',()=>choose('approve'));
  $('nb-reject').addEventListener('click',()=>choose('reject'));
  $('nb-custom').addEventListener('click',()=>choose('custom'));
  $('nb-custom-text').addEventListener('input',()=>{
    const id=proposals[position].id;decisions.set(id,{choice:'custom',text:$('nb-custom-text').value});
    $('nb-decision').textContent=$('nb-custom-text').value.trim()?'Свой вариант':'Впишите свой вариант';
    $('nb-transfer-box').hidden=true;scheduleSave();
  });
  $('nb-save-custom').addEventListener('click',()=>{
    if(!current(proposals[position].id).text.trim()){$('nb-status').textContent='Напишите свой вариант или выберите другое решение.';$('nb-custom-text').focus();return;}
    $('nb-status').textContent='';advance();render();scheduleSave();
  });
  $('nb-prev').addEventListener('click',()=>{if(position>0)position--;render();scheduleSave();});
  $('nb-next').addEventListener('click',()=>{advance();render();scheduleSave();});
  $('nb-jump').addEventListener('change',()=>{const n=Number($('nb-jump').value);if(Number.isInteger(n)&&n>=1&&n<=proposals.length)position=n-1;render();scheduleSave();});
  window.addEventListener('openai:set_globals',event=>{if(restore(event.detail?.globals?.widgetState))render();});
  function prompt() {
    return 'Мои решения по редактуре русского интерфейса NB. Примени только пункты approve и custom; для custom используй мой текст. Пункты reject и неуказанные пункты не меняй. Исходный список с привязкой к коду: /home/dopefish/projects/nb/notes/copy-review-2026-10-23/proposals.json. Перед заменой проверь текущие тексты и контекст, сохрани остальные изменения в проекте. Решения (ID, выбор, свой текст):\n'+JSON.stringify(snapshot().modelContent.decisions,null,2);
  }
  $('nb-send').addEventListener('click',async()=>{
    const empty=[...decisions].find(([,d])=>d.choice==='custom'&&!d.text.trim());
    if(empty){position=proposals.findIndex(p=>p.id===empty[0]);render();$('nb-status').textContent='Впишите свой вариант для '+empty[0]+' или выберите другое решение.';$('nb-custom-text').focus();return;}
    clearTimeout(timer);await persist();const text=prompt();
    if(typeof window.openai?.sendFollowUpMessage!=='function'){$('nb-transfer').value=text;$('nb-transfer-box').hidden=false;$('nb-status').textContent='Решения готовы для отправки в чат.';return;}
    sending=true;$('nb-send').disabled=true;
    try{await window.openai.sendFollowUpMessage({prompt:text,title:'Передать решения по текстам NB'});$('nb-status').textContent='Решения переданы в чат.';}
    catch{$('nb-transfer').value=text;$('nb-transfer-box').hidden=false;$('nb-status').textContent='Скопируйте решения и отправьте в этот чат.';}
    finally{sending=false;$('nb-send').disabled=false;}
  });
  $('nb-copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText($('nb-transfer').value);$('nb-status').textContent='Скопировано. Вставьте решения в этот чат.';}catch{$('nb-transfer').focus();$('nb-transfer').select();$('nb-status').textContent='Текст выделен для копирования.';}});
})();
</script>
