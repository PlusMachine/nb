diff --git a/apps/web/features/pwa/account-session-boundary.tsx b/apps/web/features/pwa/account-session-boundary.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..369b9a723dc0bdc2ac9aa1976d9ea0e73081bd8c
--- /dev/null
+++ b/apps/web/features/pwa/account-session-boundary.tsx
@@ -0,0 +1,37 @@
+"use client";
+
+import { useEffect, useLayoutEffect, useState, type ReactNode } from "react";
+import { GUEST_OWNER, SESSION_OWNER_KEY, syncBrowserAccount } from "./account-session";
+
+const useClientLayoutEffect = typeof window === "undefined" ? useEffect : useLayoutEffect;
+
+export function AccountSessionBoundary({ userId, children }: { userId: string | null; children: ReactNode }) {
+  const [changed, setChanged] = useState(false);
+  useClientLayoutEffect(() => {
+    // The precached anonymous offline document must retain the last signed-in
+    // user's local console links. It cannot establish an authentication state.
+    const offlineShell = Boolean(document.querySelector("[data-nb-offline-shell]"));
+    if (!offlineShell) syncBrowserAccount(userId);
+    let owner = userId ?? GUEST_OWNER;
+    if (offlineShell) {
+      try { owner = localStorage.getItem(SESSION_OWNER_KEY) ?? GUEST_OWNER; } catch { /* Optional storage. */ }
+    }
+    const check = () => {
+      try { if (localStorage.getItem(SESSION_OWNER_KEY) !== owner) setChanged(true); } catch { /* Optional storage. */ }
+    };
+    const onStorage = (event: StorageEvent) => { if (event.key === SESSION_OWNER_KEY || event.key === null) check(); };
+    const onPageShow = (event: PageTransitionEvent) => { if (event.persisted) check(); };
+    window.addEventListener("storage", onStorage);
+    window.addEventListener("pageshow", onPageShow);
+    return () => { window.removeEventListener("storage", onStorage); window.removeEventListener("pageshow", onPageShow); };
+  }, [userId]);
+
+  if (changed) return (
+    <main className="mx-auto max-w-lg space-y-4 p-8" role="status">
+      <h1 className="text-xl font-semibold">Аккаунт изменён</h1>
+      <p>Обновите страницу, чтобы продолжить с текущим аккаунтом.</p>
+      <button type="button" className="rounded-lg border px-4 py-2" onClick={() => window.location.reload()}>Обновить страницу</button>
+    </main>
+  );
+  return children;
+}
diff --git a/apps/web/features/pwa/account-session.ts b/apps/web/features/pwa/account-session.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ae4bf9965f924b24276abb58e70a4b0e987b3b98
--- /dev/null
+++ b/apps/web/features/pwa/account-session.ts
@@ -0,0 +1,37 @@
+// Private browser data belongs to a signed-in session; public PWA assets survive logout.
+export const SESSION_OWNER_KEY = "nb:session-owner";
+export const GUEST_OWNER = "guest";
+const privateKeys = new Set(["nb_device_local_urls", "nb:recipe-water:source-profiles", "nb:recipe-water:target-profiles", "nb:recipe-water:migrated"]);
+const privatePrefixes = ["nb:brew-progress:v1:", "nb-home-note:", "nb_distill_column_sensor_"];
+
+export function clearPrivateBrowserData(preserveQueueOwner?: string): void {
+  try {
+    for (const key of Object.keys(localStorage)) {
+      if (preserveQueueOwner && key.startsWith(`nb:brew-progress:v1:${preserveQueueOwner}:`)) continue;
+      if (privateKeys.has(key) || privatePrefixes.some(prefix => key.startsWith(prefix))) localStorage.removeItem(key);
+    }
+  } catch { /* Storage can be unavailable in private browsing. */ }
+}
+
+export function syncBrowserAccount(userId: string | null): void {
+  try {
+    const owner = userId ?? GUEST_OWNER;
+    const previous = localStorage.getItem(SESSION_OWNER_KEY);
+    if (previous !== owner) {
+      // A passive session expiry must not discard unsent work. Keep only the
+      // returning/current owner's scoped queue; another account cannot use it.
+      const queueOwner = userId ?? (previous && previous !== GUEST_OWNER ? previous : undefined);
+      clearPrivateBrowserData(queueOwner);
+      localStorage.setItem(SESSION_OWNER_KEY, owner);
+    }
+  } catch { /* Account access is still enforced on the server. */ }
+}
+
+export async function logoutBrowserSession(destination: string): Promise<void> {
+  const response = await fetch("/api/auth/logout", { method: "POST" });
+  if (!response.ok || !(await response.json()).ok) throw new Error("LOGOUT_FAILED");
+  clearPrivateBrowserData();
+  try { localStorage.setItem(SESSION_OWNER_KEY, GUEST_OWNER); } catch { /* Optional storage. */ }
+  // A new document drops Next's in-memory authenticated router cache.
+  window.location.assign(destination);
+}
diff --git a/apps/web/features/pwa/service-worker.js b/apps/web/features/pwa/service-worker.js
new file mode 100644
index 0000000000000000000000000000000000000000..46742b9d1166c43cf49eb8ab2b255cbcb7af4454
--- /dev/null
+++ b/apps/web/features/pwa/service-worker.js
@@ -0,0 +1,137 @@
+/* Served at /sw.js with a build-specific NB_BUILD_ID. Only anonymous offline
+ * HTML and immutable same-origin static files are cached. API/SSR/Flight and
+ * mutations always use the network. */
+const RELEASE = self.NB_BUILD_ID;
+const OFFLINE_CACHE = `nb-pwa-offline-${RELEASE}`;
+const STATIC_CACHE = `nb-pwa-static-${RELEASE}`;
+const OFFLINE_URL = "/offline";
+const MAX_STATIC_ENTRIES = 200;
+let cacheWrites = Promise.resolve();
+
+function isCacheableStaticPath(pathname) {
+  return pathname.startsWith("/_next/static/") || pathname.startsWith("/images/pwa/") || pathname === "/icon.svg";
+}
+
+async function precacheOffline() {
+  const response = await fetch(OFFLINE_URL, { cache: "reload", credentials: "omit" });
+  if (!response.ok) throw new Error(`precache /offline: HTTP ${response.status}`);
+  const html = await response.clone().text();
+  const normalized = html.replace(/\\\//g, "/");
+  const urls = [...new Set(normalized.match(/\/_next\/static\/[^"'\s)<>]+\.(?:js|css)/g) || [])];
+  if (!urls.length) throw new Error("Offline document has no application chunks");
+  const cache = await caches.open(OFFLINE_CACHE);
+  // Finish consuming each body before requesting the next mandatory asset.
+  // A failed install never publishes its incomplete offline document.
+  for (const url of urls) {
+    const asset = await fetch(url, { cache: "reload", credentials: "omit" });
+    if (!asset.ok) {
+      await asset.body?.cancel();
+      throw new Error(`precache ${url}: HTTP ${asset.status}`);
+    }
+    await cache.put(url, asset);
+  }
+  await cache.put(OFFLINE_URL, response);
+}
+
+self.addEventListener("install", event => {
+  event.waitUntil(precacheOffline().then(() => self.skipWaiting()).catch(async error => {
+    await caches.delete(OFFLINE_CACHE);
+    throw error;
+  }));
+});
+
+self.addEventListener("activate", event => {
+  event.waitUntil((async () => {
+    const keys = await caches.keys();
+    // Keep one previous release for lazy chunks requested by already open tabs.
+    const previous = keys.filter(key => key.startsWith("nb-pwa-offline-") && key !== OFFLINE_CACHE).at(-1);
+    const previousRelease = previous?.slice("nb-pwa-offline-".length);
+    const retained = new Set([OFFLINE_CACHE, STATIC_CACHE, previous, previousRelease ? `nb-pwa-static-${previousRelease}` : null]);
+    await Promise.all(keys.filter(key => (key === "nb-v1" || key.startsWith("nb-pwa-")) && !retained.has(key)).map(key => caches.delete(key)));
+    await self.clients.claim();
+  })());
+});
+
+async function matchStatic(request) {
+  const keys = await caches.keys();
+  const candidates = [OFFLINE_CACHE, STATIC_CACHE, ...keys.filter(key => key.startsWith("nb-pwa-"))];
+  for (const key of new Set(candidates)) {
+    if (!keys.includes(key)) continue;
+    const cached = await (await caches.open(key)).match(request);
+    if (cached) return cached;
+  }
+}
+
+self.addEventListener("fetch", event => {
+  const { request } = event;
+  if (request.method !== "GET") return;
+  if (request.mode === "navigate") {
+    event.respondWith(fetch(request).catch(async () => (await (await caches.open(OFFLINE_CACHE)).match(OFFLINE_URL, { ignoreVary: true })) ?? Response.error()));
+    return;
+  }
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin || !isCacheableStaticPath(url.pathname)) return;
+  event.respondWith((async () => {
+    const cached = await matchStatic(request);
+    if (cached) return cached;
+    const response = await fetch(request);
+    if (response.ok) {
+      const copy = response.clone();
+      cacheWrites = cacheWrites.catch(() => {}).then(async () => {
+        const cache = await caches.open(STATIC_CACHE);
+        await cache.put(request, copy);
+        const keys = await cache.keys();
+        for (const key of keys.slice(0, Math.max(0, keys.length - MAX_STATIC_ENTRIES))) await cache.delete(key);
+      });
+      event.waitUntil(cacheWrites.catch(() => {}));
+    }
+    return response;
+  })());
+});
+
+self.addEventListener("push", (event) => {
+  let payload = {};
+  try {
+    payload = event.data ? event.data.json() : {};
+  } catch {
+    payload = { title: "BrewForge", body: event.data ? event.data.text() : "" };
+  }
+
+  const title = payload.title || "BrewForge";
+  const options = {
+    body: payload.body || "",
+    // tag + renotify: повторные события одного рода/устройства заменяют предыдущее
+    // уведомление, но всё равно оповещают (не копятся молча).
+    tag: payload.tag || "brewforge",
+    renotify: Boolean(payload.tag),
+    data: { url: payload.url || "/app/devices" }
+    // icon/badge не задаём (ассетов пока нет) — браузер покажет дефолт без 404.
+  };
+
+  event.waitUntil(self.registration.showNotification(title, options));
+});
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close();
+  const url = (event.notification.data && event.notification.data.url) || "/app/devices";
+
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((clients) => {
+      // Уже открытая вкладка портала — фокус + навигация; иначе открываем новую.
+      for (const client of clients) {
+        if ("focus" in client) {
+          client.focus();
+          if ("navigate" in client) {
+            try {
+              client.navigate(url);
+            } catch {
+              /* кросс-origin/ограничения — просто оставляем сфокусированной */
+            }
+          }
+          return undefined;
+        }
+      }
+      return self.clients.openWindow(url);
+    })
+  );
+});
diff --git a/apps/web/tests/pwa-account-session.test.ts b/apps/web/tests/pwa-account-session.test.ts
