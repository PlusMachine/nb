{
  "name": "nb",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "trap 'exit 0' INT TERM HUP; pnpm run dev:prepare && pnpm -F @nb/web run dev",
    "dev:prepare": "pnpm run content:sync-images && pnpm run db:migrate && pnpm run db:seed",
    "dev:sim": "pnpm -F @nb/device-sim run dev -- --port 8090 --device-id bf-demo --scenario mash",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "content:sync-images": "pnpm -F @nb/content run bjcp:sync-images",
    "db:generate": "pnpm -F @nb/db run db:generate",
    "db:migrate": "pnpm -F @nb/db run db:migrate",
    "db:seed": "pnpm -F @nb/db run db:seed",
    "catalog:seed": "pnpm -F @nb/db run catalog:seed",
    "db:reset": "pnpm -F @nb/db run db:reset",
    "seed:dev-user": "pnpm -F @nb/db run seed:dev-user",
    "set-role": "pnpm -F @nb/db run set-role",
    "seed:qa": "pnpm -F @nb/db run seed:qa",
    "seed:sample": "pnpm -F @nb/web run seed:sample",
    "seed:public": "pnpm -F @nb/web run seed:public",
    "cleanup:verifications": "pnpm -F @nb/web run cleanup:verifications"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
