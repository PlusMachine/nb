{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@nb/shared/*": ["packages/shared/src/*"],
      "@nb/ui/*": ["packages/ui/src/*"],
      "@nb/db/*": ["packages/db/src/*"],
      "@nb/brewing-core/*": ["packages/brewing-core/src/*"],
      "@nb/brewforge-protocol": ["packages/brewforge-protocol/src/index.ts"],
      "@nb/auth/*": ["packages/auth/src/*"],
      "@nb/content/*": ["packages/content/src/*"],
      "@nb/search/*": ["packages/search/src/*"]
    }
  }
}
